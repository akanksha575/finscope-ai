# Application Settings
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for development)
DATABASE_URL=sqlite:///db.sqlite3

# API Keys
OPENAI_API_KEY=sk-your-openai-api-key
TAVILY_API_KEY=tvly-your-tavily-api-key

# Optional Financial Data APIs
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
FINNHUB_API_KEY=your-finnhub-key

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./data/chromadb
CHROMA_COLLECTION_IT=it_sector_docs
CHROMA_COLLECTION_PHARMA=pharma_sector_docs

# RAG Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Research Configuration
MIN_RESEARCH_STEPS=5
MAX_RESEARCH_STEPS=20
QUICK_PLAN_STEPS=5
STANDARD_PLAN_STEPS=10
DEEP_PLAN_STEPS=18

# API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FASTAPI_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/finscope.log

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Guardrails
GUARDRAILS_ENABLED=True
GUARDRAILS_CONFIG=./guardrails/config.yaml

# WebSocket
WEBSOCKET_PING_INTERVAL=30
WEBSOCKET_PING_TIMEOUT=10

# Caching
REDIS_URL=redis://localhost:6379/0